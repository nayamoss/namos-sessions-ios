import SwiftUI
import ClerkKit
import UIKit

/// Reusable Clerk sign-in screen — matches Sentio's design system.
/// Used as the signed-out app root and as a modal from Settings.
struct SignInModal: View {
    @Binding var isPresented: Bool
    var showsDismissHandle = true
    @Environment(\.colorScheme) private var colorScheme

    private enum Step {
        case email, otp
    }

    @State private var step: Step = .email
    @State private var email: String = ""
    @State private var otp: String = ""
    @State private var isLoading: Bool = false
    @State private var errorMessage: String?
    @State private var pendingSignIn: SignIn?

    var body: some View {
        ZStack {
            (colorScheme == .dark ? Color.sentioCharcoal : Color.sentioCream)
                .ignoresSafeArea()

            VStack(spacing: 0) {
                if showsDismissHandle {
                    RoundedRectangle(cornerRadius: 3)
                        .fill(colorScheme == .dark ? Color.white.opacity(0.2) : Color.sentioTextTertiary.opacity(0.3))
                        .frame(width: 36, height: 4)
                        .padding(.top, 12)
                        .padding(.bottom, 24)
                }

                ZStack(alignment: .bottom) {
                    VStack(spacing: 0) {
                        Text("sentio")
                            .font(.system(size: 15, weight: .medium, design: .rounded))
                            .tracking(4)
                            .foregroundColor(colorScheme == .dark ? .white.opacity(0.5) : .sentioTextSecondary)
                            .padding(.bottom, 48)

                        VStack(spacing: 10) {
                            Text(step == .email ? "Sign in to Sentio" : "Check your email")
                                .font(.system(size: 34, weight: .bold, design: .serif))
                                .foregroundColor(colorScheme == .dark ? .white : .sentioText)
                                .multilineTextAlignment(.center)

                            Text(step == .email
                                 ? "Use the same account as Sentio on the web."
                                : "Enter the 6-digit code sent to \(email)")
                                .font(.system(size: 16))
                                .foregroundColor(colorScheme == .dark ? .white.opacity(0.58) : .sentioTextSecondary)
                                .multilineTextAlignment(.center)
                                .lineSpacing(3)
                        }
                        .padding(.horizontal, SentioSpacing.xxl)

                        Spacer().frame(height: 40)

                        VStack(spacing: SentioSpacing.lg) {
                            if step == .email {
                                fieldLabel("Email")
                                emailInput
                                continueButton
                            } else {
                                fieldLabel("Verification code")
                                otpInput
                                verifyButton
                                resendButton
                            }
                        }
                        .padding(.horizontal, SentioSpacing.xxl)

                        if let error = errorMessage {
                            Text(error)
                                .font(SentioTypography.bodySmall)
                                .foregroundColor(.sentioError)
                                .multilineTextAlignment(.center)
                                .padding(.horizontal, SentioSpacing.xxl)
                                .padding(.top, SentioSpacing.md)
                                .transition(.opacity.combined(with: .move(edge: .top)))
                        }
                    }
                    .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .center)

                    if step == .email {
                        Text("By continuing, you agree to Sentio's Terms and Privacy Policy.")
                            .font(SentioTypography.caption)
                            .foregroundColor(colorScheme == .dark ? .white.opacity(0.35) : .sentioTextTertiary)
                            .multilineTextAlignment(.center)
                            .padding(.horizontal, SentioSpacing.xxl)
                            .padding(.bottom, 28)
                    }
                }
            }
        }
        .animation(.easeInOut(duration: 0.2), value: step)
        .animation(.easeInOut(duration: 0.15), value: errorMessage)
    }

    // MARK: - Subviews

    private func fieldLabel(_ title: String) -> some View {
        HStack(spacing: 10) {
            RoundedRectangle(cornerRadius: 2)
                .fill(Color.sentioOrange)
                .frame(width: 3, height: 14)

            Text(title.uppercased())
                .font(SentioTypography.label)
                .tracking(1.4)
                .foregroundColor(colorScheme == .dark ? .white.opacity(0.58) : .sentioTextSecondary)

            Spacer()
        }
    }

    private var emailInput: some View {
        SentioTextField(
            text: $email,
            placeholder: "you@example.com",
            keyboardType: .emailAddress,
            textContentType: .emailAddress,
            font: .systemFont(ofSize: 17),
            textAlignment: .natural,
            isDark: colorScheme == .dark
        )
        .padding(.horizontal, SentioSpacing.lg)
        .frame(height: 54)
        .background(
            RoundedRectangle(cornerRadius: SentioRadius.medium, style: .continuous)
                .fill(colorScheme == .dark ? Color.sentioDarkCard : Color.white)
                .overlay(
                    RoundedRectangle(cornerRadius: SentioRadius.medium, style: .continuous)
                        .strokeBorder(colorScheme == .dark ? Color.white.opacity(0.08) : Color.black.opacity(0.06), lineWidth: 1)
                )
        )
    }

    private var continueButton: some View {
        Button(action: handleEmailSubmit) {
            Group {
                if isLoading {
                    ProgressView()
                        .progressViewStyle(.circular)
                        .tint(.white)
                } else {
                    Text("Continue")
                        .font(.system(size: 17, weight: .semibold))
                }
            }
            .foregroundColor(email.isValidEmail ? .white : (colorScheme == .dark ? .white.opacity(0.35) : .sentioTextTertiary))
            .frame(maxWidth: .infinity)
            .frame(height: 54)
            .background(email.isValidEmail ? Color.sentioOrange : (colorScheme == .dark ? Color.white.opacity(0.1) : Color.sentioTextTertiary.opacity(0.18)))
            .cornerRadius(14)
        }
        .disabled(!email.isValidEmail || isLoading)
        .buttonStyle(ScaleButtonStyle())
    }

    private var otpInput: some View {
        SentioTextField(
            text: $otp,
            placeholder: "000000",
            keyboardType: .numberPad,
            textContentType: .oneTimeCode,
            font: .monospacedDigitSystemFont(ofSize: 28, weight: .bold),
            textAlignment: .center,
            tracking: 12,
            isDark: colorScheme == .dark
        )
        .padding(.horizontal, SentioSpacing.lg)
        .frame(height: 62)
        .background(
            RoundedRectangle(cornerRadius: SentioRadius.medium, style: .continuous)
                .fill(colorScheme == .dark ? Color.sentioDarkCard : Color.white)
                .overlay(
                    RoundedRectangle(cornerRadius: SentioRadius.medium, style: .continuous)
                        .strokeBorder(colorScheme == .dark ? Color.white.opacity(0.08) : Color.black.opacity(0.06), lineWidth: 1)
                )
        )
        .onChange(of: otp) { _, new in
            let digits = new.filter(\.isNumber)
            if digits.count > 6 { otp = String(digits.prefix(6)) }
            else { otp = digits }
        }
    }

    private var verifyButton: some View {
        Button(action: { Task { await verifyOTP() } }) {
            Group {
                if isLoading {
                    ProgressView()
                        .progressViewStyle(.circular)
                        .tint(.white)
                } else {
                    Text("Verify Code")
                        .font(.system(size: 17, weight: .semibold))
                }
            }
            .foregroundColor(otp.count == 6 ? .white : (colorScheme == .dark ? .white.opacity(0.35) : .sentioTextTertiary))
            .frame(maxWidth: .infinity)
            .frame(height: 54)
            .background(otp.count == 6 ? Color.sentioOrange : (colorScheme == .dark ? Color.white.opacity(0.1) : Color.sentioTextTertiary.opacity(0.18)))
            .cornerRadius(14)
        }
        .disabled(otp.count != 6 || isLoading)
        .buttonStyle(ScaleButtonStyle())
    }

    private var resendButton: some View {
        Button(action: {
            withAnimation { step = .email; otp = ""; errorMessage = nil }
        }) {
            Text("Use a different email")
                .font(.system(size: 14, weight: .medium))
                .foregroundColor(.sentioOrange)
        }
        .padding(.top, 4)
    }

    // MARK: - Actions

    private func handleEmailSubmit() {
        guard email.isValidEmail else { return }
        errorMessage = nil
        isLoading = true
        Task {
            do {
                let signIn = try await Clerk.shared.auth.signInWithEmailCode(emailAddress: email)
                pendingSignIn = signIn
                withAnimation { step = .otp }
            } catch {
                errorMessage = error.localizedDescription
            }
            isLoading = false
        }
    }

    private func verifyOTP() async {
        guard let signIn = pendingSignIn, otp.count == 6 else { return }
        errorMessage = nil
        isLoading = true
        do {
            let result = try await signIn.verifyCode(otp)
            if result.status == .complete {
                HapticManager.shared.notification(type: .success)
                isPresented = false
            } else {
                errorMessage = "Verification incomplete. Please try again."
            }
        } catch let clerkError as ClerkAPIError {
            if clerkError.code == "signed_out" {
                pendingSignIn = nil
                otp = ""
                withAnimation { step = .email }
                errorMessage = "Your sign-in attempt expired. Request a new code."
            } else {
                errorMessage = clerkError.errorDescription ?? "The code could not be verified. Try again."
            }
            HapticManager.shared.notification(type: .error)
        } catch {
            errorMessage = "The code could not be verified. Try again."
            HapticManager.shared.notification(type: .error)
        }
        isLoading = false
    }

}

private struct SentioTextField: UIViewRepresentable {
    @Binding var text: String
    let placeholder: String
    let keyboardType: UIKeyboardType
    let textContentType: UITextContentType?
    let font: UIFont
    let textAlignment: NSTextAlignment
    var tracking: CGFloat = 0
    let isDark: Bool

    func makeCoordinator() -> Coordinator {
        Coordinator(self)
    }

    func makeUIView(context: Context) -> UITextField {
        let textField = UITextField(frame: .zero)
        textField.borderStyle = .none
        textField.backgroundColor = .clear
        textField.keyboardType = keyboardType
        textField.textContentType = textContentType
        textField.autocapitalizationType = .none
        textField.autocorrectionType = .no
        textField.spellCheckingType = .no
        textField.smartQuotesType = .no
        textField.smartDashesType = .no
        textField.inlinePredictionType = .no
        textField.textAlignment = textAlignment
        textField.addTarget(context.coordinator, action: #selector(Coordinator.textChanged), for: .editingChanged)
        applySentioStyle(to: textField)
        return textField
    }

    func updateUIView(_ textField: UITextField, context: Context) {
        context.coordinator.parent = self
        if textField.text != text {
            textField.text = text
        }
        applySentioStyle(to: textField)
    }

    private func applySentioStyle(to textField: UITextField) {
        let textColor = isDark ? UIColor.white : UIColor(Color.sentioText)
        let placeholderColor = isDark
            ? UIColor.white.withAlphaComponent(0.35)
            : UIColor(Color.sentioTextTertiary)
        textField.font = font
        textField.textColor = textColor
        textField.tintColor = UIColor(Color.sentioOrange)
        textField.defaultTextAttributes = [
            .font: font,
            .foregroundColor: textColor,
            .kern: tracking,
        ]
        textField.attributedPlaceholder = NSAttributedString(
            string: placeholder,
            attributes: [
                .font: font,
                .foregroundColor: placeholderColor,
                .kern: tracking,
            ]
        )
    }

    final class Coordinator: NSObject {
        var parent: SentioTextField

